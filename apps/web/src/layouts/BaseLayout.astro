---
interface Props {
  title?: string;
  description?: string;
  /** OG/트위터 카드 노출 페이지(랜딩·공개 학습)만 전달 — 기본 미출력. */
  ogPath?: string;
}

const {
  title = '쪽집게 — 손해평가사 합격',
  description = '손해평가사 자격시험 AI 학습 서비스',
  ogPath,
} = Astro.props;

// G-5: 기본 = thepick-study.pages.dev (astro.config site). env 주입으로 교체 가능 — 하드코딩 금지.
const site = Astro.site?.href?.replace(/\/$/, '') ?? '';
const ogUrl = ogPath !== undefined && site !== '' ? `${site}${ogPath}` : null;
const ogImage = site !== '' ? `${site}/icons/icon-512.png` : '/icons/icon-512.png';

// P5 BE-6③ — Cloudflare Web Analytics (단일 벤더 정합, PII 0 서버리스 비콘).
// 토큰 = 빌드 시 env 주입(대시보드 발급 — 미설정이면 비콘 자체 미출력, 무음 폴백 아님:
// 배포 스크립트가 미설정을 경고 표면화).
const cfBeaconToken: string | undefined = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="description" content={description} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {
      ogUrl !== null && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="쪽집게" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={ogUrl} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:locale" content="ko_KR" />
          <meta name="twitter:card" content="summary" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
          <link rel="canonical" href={ogUrl} />
        </>
      )
    }
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Pretendard 자가호스팅 서브셋 (P4-D8 — 제3자 CDN 제거, SW CacheFirst 대상) -->
    <link
      rel="preload"
      href="/fonts/Pretendard-main.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/pretendard.css" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white font-sans text-gray-900 antialiased">
    <slot />

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.error('SW registration failed:', err);
          });
        });
      }
    </script>
    {/* SRI 미적용 사유: beacon.min.js 는 Cloudflare 가 수시 갱신(고정 해시 없음 — SRI 시
        갱신마다 지표 무음 파손). 신뢰 경계 = 호스팅 제공자 자신(Pages/Worker 와 동일 벤더)
        이라 CDN 변조 위협 모델이 4-Pass MAJOR-3(제3자 jsdelivr)과 다름. */}
    {
      cfBeaconToken !== undefined && cfBeaconToken !== '' && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </body>
</html>

<style is:global>
  /* Touch target minimum 44px for mobile */
  button,
  a,
  [role='button'],
  input[type='checkbox'],
  input[type='radio'] {
    min-height: 44px;
    min-width: 44px;
  }

  /* 텍스트 계열 입력도 44px 보장 (FE-9 carry-over — 구 규칙은 radio/checkbox 만 커버) */
  input[type='text'],
  input[type='email'],
  input[type='password'],
  input[type='search'],
  input[type='number'],
  select,
  textarea {
    min-height: 44px;
  }

  /* 디자인 정본 줄간격 유틸 — 본문 1.7 / 제목 1.3 (claudeDesign index.html 이식) */
  .tp-body {
    line-height: 1.7;
  }
  .tp-tight {
    line-height: 1.3;
  }

  /* Responsive breakpoints: 360px / 768px / 1024px */
  @media (max-width: 360px) {
    html {
      font-size: 14px;
    }
  }
</style>
