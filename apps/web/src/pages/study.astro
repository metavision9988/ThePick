---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { StudyFlow } from '@/components/StudyFlow';
import { ProgressSummary } from '@/components/ProgressSummary';
import { OfflineIndicator } from '@/components/OfflineIndicator';
---

<BaseLayout title="학습 — 쪽집게">
  <div class="mx-auto max-w-[1280px] px-4 py-8 lg:flex lg:gap-8">
    <aside class="mb-6 flex-shrink-0 lg:mb-0 lg:w-[180px]">
      <h2 class="mb-3 text-xs font-medium uppercase tracking-wide text-gray-500">진도</h2>
      <ProgressSummary client:load />
      <p class="mt-6 text-[11px] leading-relaxed text-gray-400">
        FSRS 간격반복은 약점 복습 모드에서 surface된다.
      </p>
    </aside>
    <main class="flex-1 lg:max-w-[720px]">
      <header class="mb-6">
        <h1 class="text-2xl font-medium text-gray-900">학습</h1>
        <p class="mt-1 text-sm text-gray-500">학습 모드를 선택하면 세션이 시작된다.</p>
      </header>
      <StudyFlow examType="1st" client:load />
    </main>
  </div>
  <OfflineIndicator client:load />
</BaseLayout>
